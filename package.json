{
  "name": "matches-task",
  "version": "1.0.0",
  "private": true,
  "workspaces": [
    "api",
    "packages/api"
  ],
  "main": "index.ts",
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "typecheck": "tsc --noEmit",
