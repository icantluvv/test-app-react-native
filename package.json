    "api:generate": "npm run generate --workspace=@repo/api"
  },
  "dependencies": {
    "@tanstack/react-query": "5.104.5",
    "expo": "~57.0.29",
    "expo-status-bar": "~57.0.1",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.3",
    "react-native-web": "^0.21.2",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/react": "~19.2.2",
    "typescript": "~6.0.3"
  }
}
